# Copy to .env.local to change behaviour.

# The real backend is the default: /api is proxied to localhost:8000 in dev and
# same-origin in the build the backend serves.
#
# Set to true only for an offline demo. The mock client serves the committed
# fixtures and nothing else -- figures it cannot compute (the full complaint-type
# table, the per-board map) come back empty and the UI says so, rather than being
# filled in with invented numbers.
VITE_USE_MOCK=false
