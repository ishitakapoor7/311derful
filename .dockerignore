# The 22M-row source build is 2.1GB and is never needed in the image -- without
# this the daemon would receive all of it before the build starts.
backend/data/*

# ...but two things are COPYd by the Dockerfile and must get through: the
# reference files (~3.9MB, committed) and the slim cube if it has been built
# locally with `python -m app.data.export`.
!backend/data/reference/
!backend/data/nyc311-slim.duckdb

backend/.venv/
backend/.env
frontend/node_modules/
frontend/dist/
.git/
**/__pycache__/
