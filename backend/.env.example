# Anthropic key for taxonomy mapping and advice phrasing.
# You already have one in ../../interview-prep-agent/.env — reuse it or mint a new one.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Optional. Socrata throttles unauthenticated requests hard at 22M-row volume.
# Free: https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Ingest window. A parameter, not a constant — pre-2020 is a separate dataset
# gated on a measured classifier-coverage test (see the plan).
INGEST_START=2020-01-01

# ---------------------------------------------------------------------------
# Voice. Which speech path is live is a BACKEND decision — there is no
# user-facing toggle — so it can be switched and debugged here without any
# frontend change. Restart uvicorn after editing.
#
#   webspeech  browser SpeechRecognition. No keys, no cost. Can't detect the
#              spoken language, so the UI shows a language picker.
#   vapi       Vapi web SDK in the browser (no phone number). Better accuracy,
#              real voices, auto language detection — so the picker is hidden.
#   off        no microphone; text only.
#
# `vapi` with either key missing falls back to `webspeech` rather than failing:
# a working mic beats a stack trace on demo day.
# ---------------------------------------------------------------------------
VOICE_MODE=webspeech

# Vapi's PUBLIC key — it is designed to ship to the browser. Never put the
# private key here; this value is served by GET /api/config.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
